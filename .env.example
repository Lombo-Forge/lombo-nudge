# Where Seerr answers, as seen from this app (a container name works when both share a network).
LOMBO_NUDGE_SEERR_URL=http://seerr:5055
# Seerr: Settings > General > API Key.
LOMBO_NUDGE_SEERR_API_KEY=changeme
# Sonarr (shows). Set the URL and key, or leave both empty to skip shows. Need at least one of Sonarr and Radarr.
LOMBO_NUDGE_SONARR_URL=
# Sonarr: Settings > General > API Key. Typical URL: http://sonarr:8989
LOMBO_NUDGE_SONARR_API_KEY=
# Radarr (movies). Set the URL and key, or leave both empty to skip movies.
LOMBO_NUDGE_RADARR_URL=
# Radarr: Settings > General > API Key. Typical URL: http://radarr:7878
LOMBO_NUDGE_RADARR_API_KEY=
# Optional. A second Radarr that Seerr sends 4K movie requests to. Without it, 4K requests are skipped.
LOMBO_NUDGE_RADARR_4K_URL=
# That Radarr: Settings > General > API Key. Typical URL: http://radarr-4k:7878
LOMBO_NUDGE_RADARR_4K_API_KEY=
# Optional. With Jellyfin set, "imported but not in the library" can be told apart from "Seerr not updated".
LOMBO_NUDGE_JELLYFIN_URL=
# Jellyfin: Dashboard > API Keys > +. One key per app, so you can revoke it alone. Typical URL: http://jellyfin:8096
LOMBO_NUDGE_JELLYFIN_API_KEY=
# Optional. Any webhook that accepts JSON (Discord, Slack, or a bridge). Empty means no alerts.
LOMBO_NUDGE_WEBHOOK_URL=
# true = show what would happen and change nothing (no alerts, no retries). Set false only after reading `plan`.
LOMBO_NUDGE_DRY_RUN=true
# Seconds between rounds when running with --loop. At least 60.
LOMBO_NUDGE_INTERVAL_SECONDS=3600
# Hours after approval before "nothing found" or "missing" is reported.
LOMBO_NUDGE_SEARCH_AFTER_HOURS=24
# Hours a show must sit with some but not all episodes before "partly here" is reported.
LOMBO_NUDGE_PARTLY_AFTER_HOURS=72
# Hours without download progress before a download counts as stalled.
LOMBO_NUDGE_STALL_AFTER_HOURS=12
# Days before a request that is still stuck for the same reason is announced again.
LOMBO_NUDGE_REALERT_DAYS=7
# Minutes `retry` refuses to act again on the same request after it did something.
LOMBO_NUDGE_RETRY_COOLDOWN_MINUTES=30
# Where it remembers progress and sent alerts. Mount a folder at /data so it survives restarts.
LOMBO_NUDGE_STATE_FILE=/data/state.json
# Optional. The token for `lombo-nudge serve`, the small HTTP API (docs/contracts.md). Empty means `serve` will not start.
# Use at least 24 visible characters with no spaces, for example `openssl rand -hex 32`.
LOMBO_NUDGE_API_TOKEN=
# Where `serve` listens: an IP address and a port. Keep it on 127.0.0.1 unless a private container network needs more.
LOMBO_NUDGE_API_BIND=127.0.0.1:8095
